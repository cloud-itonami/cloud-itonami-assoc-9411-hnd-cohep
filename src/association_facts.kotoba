          (string=? f "url-provenance") (option-some-of [:option :string] "official-cohep-org")
          (string=? f "established-date") (option-some-of [:option :string] "1967")
          (string=? f "retrieved-at") (option-some-of [:option :string] "2026-09-06")
          :else (option-none-of [:option :string]))
