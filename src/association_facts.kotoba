(defn topic-count [a :string i :i64] :i64
  (if (valid-entry? a i)
    (cond
    (= i 0) 1
    (= i 1) 1
    (= i 2) 2
    (= i 3) 1
    (= i 4) 1
    (= i 5) 1
    (= i 6) 1
    (= i 7) 2
    (= i 8) 1
    (= i 9) 2
    (= i 10) 2
    (= i 11) 2
    (= i 12) 1
    (= i 13) 1
    :else 0)
    0))

(defn topic [a :string i :i64 t :i64] [:option :string]
  (if (valid-entry? a i)
    (cond
      (= i 0) (cond
          (= t 0) (option-some-of [:option :string] "governance")
          :else (option-none-of [:option :string]))
      (= i 1) (cond
          (= t 0) (option-some-of [:option :string] "governance")
          :else (option-none-of [:option :string]))
      (= i 2) (cond
          (= t 0) (option-some-of [:option :string] "ethics")
          (= t 1) (option-some-of [:option :string] "governance")
          :else (option-none-of [:option :string]))
      (= i 3) (cond
          (= t 0) (option-some-of [:option :string] "ethics")
          :else (option-none-of [:option :string]))
      (= i 4) (cond
          (= t 0) (option-some-of [:option :string] "ethics")
          :else (option-none-of [:option :string]))
      (= i 5) (cond
          (= t 0) (option-some-of [:option :string] "governance")
          :else (option-none-of [:option :string]))
      (= i 6) (cond
          (= t 0) (option-some-of [:option :string] "governance")
          :else (option-none-of [:option :string]))
      (= i 7) (cond
          (= t 0) (option-some-of [:option :string] "governance")
          (= t 1) (option-some-of [:option :string] "labor")
          :else (option-none-of [:option :string]))
      (= i 8) (cond
          (= t 0) (option-some-of [:option :string] "governance")
          :else (option-none-of [:option :string]))
      (= i 9) (cond
          (= t 0) (option-some-of [:option :string] "membership")
          (= t 1) (option-some-of [:option :string] "ethics")
          :else (option-none-of [:option :string]))
      (= i 10) (cond
          (= t 0) (option-some-of [:option :string] "enforcement")
          (= t 1) (option-some-of [:option :string] "ethics")
          :else (option-none-of [:option :string]))
      (= i 11) (cond
          (= t 0) (option-some-of [:option :string] "governance")
          (= t 1) (option-some-of [:option :string] "ethics")
          :else (option-none-of [:option :string]))
      (= i 12) (cond
          (= t 0) (option-some-of [:option :string] "governance")
          :else (option-none-of [:option :string]))
      (= i 13) (cond
          (= t 0) (option-some-of [:option :string] "membership")
          :else (option-none-of [:option :string]))
      :else (option-none-of [:option :string]))
    (option-none-of [:option :string])))

(defn by-topic-count [a :string candidate :string] :i64
  (if (association-covered? a)
    (cond
    (string=? candidate "governance") 9
    (string=? candidate "ethics") 6
    (string=? candidate "labor") 1
    (string=? candidate "membership") 2
    (string=? candidate "enforcement") 1
    :else 0)
    0))

(defn by-topic-id [a :string candidate :string i :i64] [:option :string]
  (if (association-covered? a)
    (cond
    (string=? candidate "governance") (cond
        (= i 0) (entry-field a 0 "id")
        (= i 1) (entry-field a 1 "id")
        (= i 2) (entry-field a 2 "id")
        (= i 3) (entry-field a 5 "id")
        (= i 4) (entry-field a 6 "id")
        (= i 5) (entry-field a 7 "id")
        (= i 6) (entry-field a 8 "id")
        (= i 7) (entry-field a 11 "id")
        (= i 8) (entry-field a 12 "id")
        :else (option-none-of [:option :string]))
    (string=? candidate "ethics") (cond
        (= i 0) (entry-field a 2 "id")
        (= i 1) (entry-field a 3 "id")
        (= i 2) (entry-field a 4 "id")
        (= i 3) (entry-field a 9 "id")
        (= i 4) (entry-field a 10 "id")
        (= i 5) (entry-field a 11 "id")
        :else (option-none-of [:option :string]))
    (string=? candidate "labor") (cond
        (= i 0) (entry-field a 7 "id")
        :else (option-none-of [:option :string]))
    (string=? candidate "membership") (cond
        (= i 0) (entry-field a 9 "id")
        (= i 1) (entry-field a 13 "id")
        :else (option-none-of [:option :string]))
    (string=? candidate "enforcement") (cond
        (= i 0) (entry-field a 10 "id")
        :else (option-none-of [:option :string]))
    :else (option-none-of [:option :string]))
    (option-none-of [:option :string])))

(defn coverage-note [a :string] [:option :string]
  (if (association-covered? a)
    (option-some-of [:option :string] "cloud-itonami-assoc-9411-hnd-cohep Wave 0 (ADR-2607141700): 14 COHEP entries -- 12 from COHEP's own publication, 1 Wikipedia-corroborated, 1 contradicted by another page of COHEP's own site. Extend `association.facts/catalog`, never fabricate an id/url.")
    (option-none-of [:option :string])))

(defn main [] :i64 0)
